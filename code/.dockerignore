# Secrets stay out of the build context.
.env
.env.*
**/.env
**/.env.*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/credentials.json
**/.npmrc
**/id_rsa
**/id_rsa.pub

# Dependencies and build output are produced inside the image.
**/node_modules
**/dist
**/.next
**/build

# Design captures stay out of the image, except the HTML the web server reads.
design-stitch/*
!design-stitch/11-auth/
design-stitch/11-auth/*
!design-stitch/11-auth/screen.html
!design-stitch/12-age-gate/
design-stitch/12-age-gate/*
!design-stitch/12-age-gate/screen.html
!design-stitch/13-email-verification/
design-stitch/13-email-verification/*
!design-stitch/13-email-verification/screen.html
!design-stitch/14-otp/
design-stitch/14-otp/*
!design-stitch/14-otp/screen.html
!design-stitch/17-id-liveness/
design-stitch/17-id-liveness/*
!design-stitch/17-id-liveness/screen.html

# Restore-drill data must not enter the image build context.
pg-data
pg-wal
pg-base
